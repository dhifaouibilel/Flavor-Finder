<section class="section" style="background: var(--bg)">
  <div class="container">
    <div class="row align-items-end mb-4">
      <div class="col">
        <div class="section-eyebrow">Hand-picked for you</div>
        <h2 class="section-title">Today's <em>featured</em> recipes</h2>
        <div class="divider"></div>
      </div>
      <div class="col-auto">
        <a
          href="#"
          style="
            font-size: 0.82rem;
            color: var(--orange);
            text-decoration: none;
          "
        >
          See all <i class="bi bi-arrow-right"></i>
        </a>
      </div>
    </div>

    <div class="row g-4" id="featuredGrid">
      <!-- Skeletons -->
      <div class="col-sm-6 col-lg-3">
        <div class="recipe-card">
          <div class="skeleton" style="height: 180px; border-radius: 0"></div>
          <div style="padding: 14px 16px">
            <div
              class="skeleton"
              style="height: 12px; width: 50%; margin-bottom: 10px"
            ></div>
            <div
              class="skeleton"
              style="height: 18px; width: 80%; margin-bottom: 14px"
            ></div>
            <div class="skeleton" style="height: 12px; width: 40%"></div>
          </div>
        </div>
      </div>
      <div class="col-sm-6 col-lg-3">
        <div class="recipe-card">
          <div class="skeleton" style="height: 180px; border-radius: 0"></div>
          <div style="padding: 14px 16px">
            <div
              class="skeleton"
              style="height: 12px; width: 50%; margin-bottom: 10px"
            ></div>
            <div
              class="skeleton"
              style="height: 18px; width: 80%; margin-bottom: 14px"
            ></div>
            <div class="skeleton" style="height: 12px; width: 40%"></div>
          </div>
        </div>
      </div>
      <div class="col-sm-6 col-lg-3">
        <div class="recipe-card">
          <div class="" style="height: 180px; border-radius: 0">
            <img
              src="<%= randomMeal.strMealThumb %>"
              alt="<%= randomMeal.strMeal %>"
            />
          </div>
          <div style="padding: 14px 16px">
            <div class="" style="height: 12px; width: 50%; margin-bottom: 10px">
              <%= randomMeal.strMeal %>
            </div>
            <div
              class="skeleton"
              style="height: 18px; width: 80%; margin-bottom: 14px"
            ></div>
            <div class="skeleton" style="height: 12px; width: 40%"></div>
          </div>
        </div>
      </div>
      <div class="col-sm-6 col-lg-3">
        <div class="recipe-card">
          <div class="skeleton" style="height: 180px; border-radius: 0"></div>
          <div style="padding: 14px 16px">
            <div
              class="skeleton"
              style="height: 12px; width: 50%; margin-bottom: 10px"
            ></div>
            <div
              class="skeleton"
              style="height: 18px; width: 80%; margin-bottom: 14px"
            ></div>
            <div class="skeleton" style="height: 12px; width: 40%"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
